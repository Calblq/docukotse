# Copy to .env and change the secrets. Never commit .env.

# Postgres (also used to build DATABASE_URL in docker-compose.yml)
POSTGRES_USER=cardocs
POSTGRES_PASSWORD=cardocs
POSTGRES_DB=cardocs

# S3-compatible file storage (RustFS container in docker-compose.yml)
S3_ACCESS_KEY=cardocs
S3_SECRET_KEY=cardocs-secret
S3_BUCKET=car-docs
# Host the browser uses to open signed download URLs
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Ollama runs on the host (uses the GPU); the API container reaches it here
OLLAMA_URL=http://host.docker.internal:11434
EMBED_MODEL=bge-m3
LLM_MODEL=qwen2.5:7b-instruct

# Demo accounts created by scripts/seed.py (demo only)
SEED_ADMIN_EMAIL=admin@cardocs.local
SEED_ADMIN_PASSWORD=admin123
SEED_STAFF_EMAIL=staff@cardocs.local
SEED_STAFF_PASSWORD=staff123

# Retrieval and answering (defaults shown)
# RERANK_ENABLED=true            # cross-encoder reranker; ~2 GB download on first question
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# ABSTAIN_RERANK_THRESHOLD=0.2   # below this best-chunk score, answer "not found" without the LLM
# RETRIEVAL_TOP_K=20
# FINAL_K=5
# LLM_TIMEOUT_S=120             # raise if Ollama runs on CPU only
# CORS_ORIGINS=["http://localhost:3000"]
